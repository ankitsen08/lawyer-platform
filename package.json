{
  "name": "lawyer-directory-monorepo",
  "version": "1.0.0",
  "main": "server.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "postinstall": "npm install --prefix frontend && npm install --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm install --prefix backend",
    "build": "node -e \"if(!require('fs').existsSync('frontend/node_modules')) require('child_process').execSync('npm install --prefix frontend && npm install --prefix backend', {stdio:'inherit'});\" && npm run build --prefix frontend && node scripts/copy-build.js",
    "start": "node server.js",
    "start:concurrent": "concurrently \"npm run start --prefix frontend\" \"node backend/server.js\"",
    "start:frontend": "npm run start --prefix frontend",
    "start:backend": "node backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "node backend/server.js",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "seed": "node backend/seed.js"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.4"
  }
}
