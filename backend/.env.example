# Production Server Configuration
PORT=3001
NODE_ENV=production
CLIENT_ORIGIN=https://lawyercomparison.com

# Database & Security
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lawyer_directory?retryWrites=true&w=majority
JWT_SECRET=production_cryptographic_secret_change_in_production

# Stripe Payments & Subscriptions
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ESSENTIAL=price_essential_free
STRIPE_PRICE_PREMIUM=price_premium_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# Transactional Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=LawyerComparison <notifications@lawyercomparison.com>
